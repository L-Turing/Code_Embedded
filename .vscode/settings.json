{
    "files.associations": {
        "*.cpp": "cpp",
        "*.h": "c",
        "compare": "c",
        "cmath": "cpp",
        "text_encoding": "cpp",
        "array": "cpp"
    },
    "editor.formatOnSave": true,
    "[c]": {
        "editor.formatOnSave": false,
    },
    "cortex-debug.variableUseNaturalFormat": true,
    "cmake.configureOnOpen": true,
    "cmake.options.advanced": {
        "configurePreset": {
            "statusBarVisibility": "visible",
        },
        "build": {
            "statusBarVisibility": "hidden",
        },
        "launch": {
            "statusBarVisibility": "hidden",
        },
        "debug": {
            "statusBarVisibility": "hidden",
        },
    },
}